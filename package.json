{
  "name": "music-city",
  "private": true,
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a",
  "scripts": {
    "contract:build": "cargo build --manifest-path contracts/Cargo.toml --target wasm32v1-none --release",
    "contract:test": "cargo test --manifest-path contracts/Cargo.toml",
    "dev:admin": "pnpm --filter admin dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter server --filter client --filter admin test",
    "test:referrals": "bash scripts/verify-referrals.sh",
    "test:early-user-discount": "bash scripts/verify-referrals.sh",
    "test:e2e:early-user-discount": "bash scripts/verify-early-user-discount-browser.sh",
    "test:track-credits": "bash scripts/verify-track-credits.sh",
    "test:e2e:track-credits": "bash scripts/verify-track-credits.sh --browser",
    "test:e2e:studio-ui": "bash scripts/verify-track-credits.sh --studio",
    "test:e2e:release-flow": "bash scripts/verify-track-credits.sh --release",
    "test:e2e:studio-audit": "bash scripts/verify-track-credits.sh --audit",
    "dev:worker": "pnpm --filter server dev:worker",
    "dev:financial-worker": "pnpm --filter server dev:financial-worker",
    "settlements:demo:testnet": "bash scripts/settlement-testnet-demo.sh"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "railway": "^3.16.0"
  }
}
